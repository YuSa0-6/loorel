{
  "name": "loorel-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "check": "vp check",
    "test": "vp test run",
    "plan": "node packages/define/src/sync.ts --plan",
    "apply": "node packages/define/src/sync.ts --apply",
    "smoke": "node packages/client/src/smoke.ts",
    "pipeline": "node infra/runpod/pipeline.ts",
    "types": "node packages/define/src/types.ts"
  },
  "dependencies": {
    "@loorel/client": "workspace:*",
    "@loorel/define": "workspace:*",
    "ai": "^6"
  },
  "devDependencies": {
    "@types/node": "22",
    "fallow": "3.33.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@1.0.0"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    }
  }
}
